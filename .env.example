# 复制为 .env 后填入真实密钥。真实 .env 已被 .gitignore 排除。
PORT=3204
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/postgres
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_PER_MIN=20

# LangSmith：开 trace 会把 prompt / 工具参数 / 输出发送到 LangSmith，生产需评估数据合规
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent_harness_gongdan
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# LLM：fake 为零成本确定性应答；openai 走 OpenAI 兼容 /chat/completions
LLM_PROVIDER=fake
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=3072
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
# LLM judge：默认用非 reasoning 模型，输出严格 JSON；留空脚本自动用 deepseek-chat
JUDGE_LLM_MODEL=
# EVAL_SMITH_STRICT=true 时 judge 分数低于 out/eval-smith-baseline.json 会退出 1
EVAL_SMITH_STRICT=false

# Embedding：未填 key 自动降级 fake hash 向量（仍是 1024 维，真实写入 pgvector）
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMS=1024
EMBEDDING_BATCH_SIZE=32

CONTEXT_WINDOW_TOKENS=32000
CONTEXT_HEADROOM_RATIO=0.35
CTX_SYSTEM_TOKENS=2000
CTX_STATE_TOKENS=500
CTX_RECENT_TOKENS=4000
CTX_MEMORY_TOKENS=1500
CTX_RAG_TOKENS=1500
CTX_REMOTE_TOKENS=1000

RAG_CHUNK_TOKENS=512
RAG_CHUNK_OVERLAP=0.15
RAG_RECALL_TOPK=30
RAG_RRF_K=60
RAG_RERANK_TOPN=20
RAG_RERANK_THRESHOLD=0.30
RAG_EVIDENCE_MAX=6
RAG_EVIDENCE_CHUNK_TOKENS=800

MAX_INPUT_CHARS=8000
MAX_OUTPUT_CHARS=4000
MAX_TOOL_OUTPUT_CHARS=6000
MAX_STEPS=14
MAX_WALL_MS=60000

DISTILL_BATCH_SIZE=8
QUEUE_CONCURRENCY=2
