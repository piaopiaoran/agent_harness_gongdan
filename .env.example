# 复制为 .env 后填入真实密钥。真实 .env 已被 .gitignore 排除。
PORT=3204
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/postgres
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_PER_MIN=20

# LangSmith：开 trace 会把 prompt / 工具参数 / 输出发送到 LangSmith，生产需评估数据合规
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent_harness_gongdan
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 旧版 LangSmith Gateway 配置，judge 已改为直连 TypeSafe，保留仅为兼容
LANGSMITH_GATEWAY_BASE_URL=https://gateway.smith.langchain.com
# token → 成本：内置参考价（USD / 1M tokens）可用 JSON 覆盖；生产务必按实际账单填写
# 例：{"deepseek-flash":{"input":0.27,"output":1.1,"cachedInput":0.07}}
MODEL_PRICING_JSON={}

# LLM：fake 为零成本确定性应答；openai 走 OpenAI 兼容 /chat/completions
LLM_PROVIDER=fake
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=3072
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
# 评测 judge：Jev（TypeSafe System One），离线与在线共用同一模型 / 同一把 key / 同一套 question 名
# 本地直连 TypeSafe：JUDGE_API_KEY 填本机密钥（.env 已 gitignore），不要提交到仓库。
# 在线 evaluator 在 Smith UI 里建，用 workspace secret TYPESAFE_API_KEY 存同一把 key。
JUDGE_API_KEY=
JUDGE_BASE_URL=https://api.typesafe.ai
JUDGE_MODEL=jev-latest
JUDGE_TIMEOUT_MS=30000
# EVAL_SMITH_STRICT=true 时 judge 分数低于 out/eval-smith-baseline.json 会退出 1
EVAL_SMITH_STRICT=false

# Embedding：未填 key 自动降级 fake hash 向量（仍是 1024 维，真实写入 pgvector）
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMS=1024
EMBEDDING_BATCH_SIZE=32

# Rerank 主路：siliconflow 走 BAAI/bge-reranker-v2-m3 cross-encoder；heuristic 仅作降级/离线兜底。
# RERANK_SHADOW=true 时双跑、只记录两种分数，排序仍用 heuristic，不切流量。
# API key 留空则复用 EMBEDDING_API_KEY；阈值必须与 heuristic 的 0.30 分开标定。
# 实测 BGE top1 落在 0.05~0.93，取 0.05；代码另有 top1 保底，不会因阈值过高清空证据。
RERANK_PROVIDER=siliconflow
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT_MS=8000
RERANK_MAX_CHARS=1600
RERANK_API_THRESHOLD=0.05
RERANK_SHADOW=false

CONTEXT_WINDOW_TOKENS=32000
CONTEXT_HEADROOM_RATIO=0.35
CTX_SYSTEM_TOKENS=2000
CTX_STATE_TOKENS=500
CTX_RECENT_TOKENS=4000
CTX_MEMORY_TOKENS=1500
CTX_RAG_TOKENS=1500
CTX_REMOTE_TOKENS=1000

RAG_CHUNK_TOKENS=512
RAG_CHUNK_OVERLAP=0.15
RAG_RECALL_TOPK=30
RAG_RRF_K=60
RAG_RERANK_TOPN=20
RAG_RERANK_THRESHOLD=0.30
RAG_EVIDENCE_MAX=6
RAG_EVIDENCE_CHUNK_TOKENS=800

MAX_INPUT_CHARS=8000
MAX_OUTPUT_CHARS=4000
MAX_TOOL_OUTPUT_CHARS=6000
MAX_STEPS=14
MAX_WALL_MS=60000

# 记忆蒸馏：与主对话模型解耦，显式指定 deepseek-flash 并关 thinking（见 src/memory/distiller.js）
# 抽取是高频短结构化任务，V4 默认思考模式下 temperature 不生效、还会污染 JSON content
DISTILL_LLM_MODEL=deepseek-flash
DISTILL_MAX_TOKENS=768
DISTILL_BATCH_SIZE=8
# 独立凭据留空表示复用主 LLM key（共享配额）；上量后填独立 key 做配额隔离。
DISTILL_API_KEY=
DISTILL_BASE_URL=
DISTILL_JSON_MODE=object
DISTILL_EXTRACTOR_VERSION=v2-consolidate-2026-11-26
DISTILL_CONSOLIDATE_LLM=true
DISTILL_DAILY_TOKEN_BUDGET=200000
# 整合 / 遗忘 / 召回
FACT_MERGE_THRESHOLD=0.82
MEMORY_HALFLIFE_DAYS=70
MEMORY_MIN_SIMILARITY=0.05
MEMORY_FACT_TTL_DAYS=180
MEMORY_EPISODE_TTL_DAYS=90
MEMORY_SWEEP_INTERVAL_MS=21600000
RECALL_MODE=tool
# 队列可靠性：attempts/backoff/lease
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_MS=1000
QUEUE_CLAIM_LEASE_MS=120000
QUEUE_CONCURRENCY=2
